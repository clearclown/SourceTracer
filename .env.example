# SourceTracer Environment Variables Template
# Copy this file to .env and fill in your values

# Application Configuration
APP_ENV=development
APP_DEBUG=true

# Server Ports
API_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database Configuration (PostgreSQL)
POSTGRES_USER=factcheck
POSTGRES_PASSWORD=factcheck_dev_changeme
POSTGRES_DB=sourcetracer

# LLM Providers (At least one required for LLM-based classification)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_LLM_PROVIDER=claude

# Search Providers
GOOGLE_API_KEY=
GOOGLE_CX=

# Redis
REDIS_URL=redis://localhost:6379/0
