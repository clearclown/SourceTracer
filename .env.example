# ========================================
# SourceTracer - Environment Variables
# ========================================
# コピーして使用: cp .env.example .env
# 警告: .env は絶対にGitにコミットしないこと

# ========================================
# Application Settings
# ========================================
APP_ENV=development  # development, staging, production
APP_PORT=8080
APP_DEBUG=true
APP_LOG_LEVEL=info  # debug, info, warn, error

# ========================================
# LLM Providers
# ========================================
# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.3

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4000

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Default LLM Provider (openai, claude, deepseek)
DEFAULT_LLM_PROVIDER=claude

# LLM Request Settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_CACHE_TTL_HOURS=24

# ========================================
# Database - PostgreSQL
# ========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sourcetracer
DATABASE_USER=sourcetracer_user
DATABASE_PASSWORD=your_secure_password_here
DATABASE_SSLMODE=disable  # require for production

# Connection Pool
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME_MINUTES=30

# Full Database URL (overrides individual settings if set)
# DATABASE_URL=postgresql://sourcetracer_user:password@localhost:5432/sourcetracer?sslmode=disable

# ========================================
# Database - MongoDB
# ========================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=sourcetracer_raw
MONGODB_USER=mongo_user
MONGODB_PASSWORD=your_mongo_password_here

# Full MongoDB URL (overrides individual settings if set)
# MONGODB_URL=mongodb://mongo_user:password@localhost:27017/sourcetracer_raw

# ========================================
# Redis Cache
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Full Redis URL (overrides individual settings if set)
# REDIS_URL=redis://:password@localhost:6379/0

# ========================================
# Search APIs
# ========================================
# Google Custom Search
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SEARCH_ENGINE_ID=xxxxxxxxxxxxxxxxxxxxx

# Semantic Scholar (通常APIキー不要、レート制限緩和用)
SEMANTIC_SCHOLAR_API_KEY=

# PubMed (オプション - レート制限緩和用)
PUBMED_API_KEY=

# CrossRef (推奨 - mailto登録でレート制限緩和)
CROSSREF_MAILTO=your-email@example.com

# ========================================
# Playwright Browser Automation
# ========================================
PLAYWRIGHT_BROWSER=chromium  # chromium, firefox, webkit
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# Browser Pool Settings
PLAYWRIGHT_MAX_BROWSERS=5
PLAYWRIGHT_BROWSER_REUSE=true

# Screenshot for debugging
PLAYWRIGHT_SCREENSHOT_ON_ERROR=false

# ========================================
# Search Engine Settings
# ========================================
# DuckDuckGo (Playwright経由 - APIキー不要)
DUCKDUCKGO_ENABLED=true
DUCKDUCKGO_MAX_RESULTS=10

# Baidu (Playwright経由 - APIキー不要)
BAIDU_ENABLED=true
BAIDU_MAX_RESULTS=10

# ========================================
# API Server Settings
# ========================================
# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# JWT Authentication (将来的な認証機能用)
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRATION_HOURS=24

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ========================================
# Worker Settings
# ========================================
WORKER_CONCURRENCY=10
WORKER_QUEUE_NAME=sourcetracer_jobs
WORKER_POLL_INTERVAL_SECONDS=5

# ========================================
# Credibility Scoring Weights
# ========================================
CREDIBILITY_ACADEMIC_WEIGHT=0.4
CREDIBILITY_REPUTATION_WEIGHT=0.3
CREDIBILITY_RECENCY_WEIGHT=0.15
CREDIBILITY_CITATIONS_WEIGHT=0.15

# Minimum credibility threshold (0.0-1.0)
CREDIBILITY_MINIMUM_THRESHOLD=0.5

# ========================================
# Storage (for future file uploads)
# ========================================
STORAGE_TYPE=local  # local, gcs, s3
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_SIZE_MB=10

# Google Cloud Storage (production)
# GCS_BUCKET_NAME=sourcetracer-storage
# GCS_PROJECT_ID=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ========================================
# Monitoring & Logging
# ========================================
# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ========================================
# Development Tools
# ========================================
# Air (Hot Reload) - 開発時のみ
AIR_ENABLED=true

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_HOST=localhost:8080

# ========================================
# Testing
# ========================================
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5433/sourcetracer_test
TEST_MONGODB_URL=mongodb://test_user:test_pass@localhost:27018/sourcetracer_test
TEST_REDIS_URL=redis://localhost:6380/1

# Mock LLM for testing (避けるべき実APIコール)
TEST_MOCK_LLM=true
TEST_MOCK_BROWSER=true

# ========================================
# Feature Flags
# ========================================
FEATURE_MULTIMODAL_ANALYSIS=false  # 将来的な画像分析機能
FEATURE_COLLABORATIVE_EDITING=false
FEATURE_REALTIME_WEBSOCKET=false
